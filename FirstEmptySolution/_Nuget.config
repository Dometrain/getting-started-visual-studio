<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- ============================================================
       Package Sources
       <clear/> ignores all upper level configs
       ============================================================ -->
  <packageSources>
    <clear />
    <add key="nuget.org"
         value="https://api.nuget.org/v3/index.json"
         protocolVersion="3" />
    <add key="contoso-internal"
         value="https://pkgs.dev.azure.com/contoso/_packaging/contoso-internal/nuget/v3/index.json"
         protocolVersion="3" />
    <add key="local-dev"
         value="..\artifacts\packages" />
  </packageSources>

  <!-- ============================================================
       Disabled configs (instead of removing completely)
       ============================================================ -->
  <disabledPackageSources>
    <add key="local-dev" value="true" />
  </disabledPackageSources>

  <!-- ============================================================
       PACKAGE SOURCE MAPPING — dependency confusion protection
       Once you do source mapping,
        you HAVE TO define it for all the sources
       ============================================================ -->
  <packageSourceMapping>
    <packageSource key="contoso-internal">
      <package pattern="Contoso.*" />
      <package pattern="Contoso.Internal.*" />
      <package pattern="MyApp.Shared.*" />
    </packageSource>

    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <!-- ============================================================
       Credentials
       Use %VAR% pattern for reading it from Environment Vars
       ============================================================ -->
  <packageSourceCredentials>
    <contoso-internal>
      <add key="Username" value="%CONTOSO_FEED_USER%" />
      <add key="ClearTextPassword" value="%CONTOSO_FEED_PAT%" />
    </contoso-internal>
  </packageSourceCredentials>

  <!-- ============================================================
       Nuget configs
       ============================================================ -->
  <config>
    <add key="globalPackagesFolder" value="D:\NuGetPackages" />
    <add key="signatureValidationMode" value="accept" />
     <add key="http_proxy" value="http://proxy.contoso.local:8080" /> 
  </config>

  <!-- ============================================================
       Trusted Signers - Accepts packages only from this providers
       ============================================================ -->
  <trustedSigners>
    <author name="microsoft">
      <certificate fingerprint="3F9001EA83C560D712C24CF213C3D312CB3BFF51EE89435D3430BD06B5D0EECE"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
    </author>
    <repository name="nuget.org" serviceIndex="https://api.nuget.org/v3/index.json">
      <certificate fingerprint="0E5F38F57DC1BCC806D8494F4F90FBCEDD988B46760709CBEEC6F4219AA6157D"
                   hashAlgorithm="SHA256"
                   allowUntrustedRoot="false" />
      <owners>microsoft;dotnetframework;serilog;xunit</owners>
    </repository>
  </trustedSigners>

</configuration>
