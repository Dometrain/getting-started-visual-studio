<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DefineConstants>$(DefineConstants);FEATURE_PREVIEW</DefineConstants>
	</PropertyGroup>




	<PropertyGroup Condition="'$(Configuration)'=='Debug' And '$(USERNAME)' == 'SC'">
		<DefineConstants>$(DefineConstants);MY_LOCAL_PC</DefineConstants>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Debug' And '$(COMPUTERNAME)' == 'DESKTOP-PC'">
		<DefineConstants>$(DefineConstants);MY_LOCAL_PC</DefineConstants>
	</PropertyGroup>


	<PropertyGroup Condition="'$(Configuration)'=='Debug' And '$(DevelopmentMode)' == 'Enabled'">
		<DefineConstants>$(DefineConstants);MY_LOCAL_PC</DefineConstants>
	</PropertyGroup>






	<!--Nuget Packages-->
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.0" />
		<PackageReference Include="Ruvio.Client" Version="0.2.10" />
	</ItemGroup>


	<!--File Properties-->
	<ItemGroup>
		<None Update="appSettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Docs\Comments.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Docs\LoremIpsum.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Docs\Posts.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
